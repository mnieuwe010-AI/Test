# Claude API (vision-extractie van de CMR-bonnen)
ANTHROPIC_API_KEY=

# JID van de WhatsApp-groep die gemonitord moet worden, bv. 1234567890-1234567890@g.us
# Onbekend? Start het systeem met WHATSAPP_LOG_ALL_GROUPS=true om de JID van elk
# binnenkomend groepsbericht in de console te loggen, kies de juiste, zet 'm hier en
# zet de logvlag weer uit.
WHATSAPP_GROUP_JID=
WHATSAPP_LOG_ALL_GROUPS=false

# Root van de gemounte NAS-share, bv. /mnt/cmr-nas (Linux/VPS) of C:\CMR_Bonnen (lokaal testen op Windows)
NAS_ROOT=./data/nas-local-test

# Lokale spoolmap: fallback-opslag als de NAS tijdelijk onbereikbaar is
PENDING_SPOOL_DIR=./data/pending-spool

# SQLite databasebestand
DATABASE_PATH=./data/db.sqlite

# Map met de Baileys-authenticatiesessie (na eenmalig scannen van de QR-code)
BAILEYS_AUTH_DIR=./data/baileys-auth

# Optioneel: stuur een bevestiging/waarschuwing terug in de WhatsApp-groep
NOTIFY_IN_WHATSAPP=false
